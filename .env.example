# Copy this file to .env and fill in your keys.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Password for the admin page (/admin), where you add and process books.
# Without a password the admin page is disabled. Choose a long password; the user name does not matter.
ADMIN_PASSWORD=

# Optional: a different ElevenLabs voice (voice id from your ElevenLabs Voice Library).
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional: a different port (default 3000). The server only listens on 127.0.0.1.
# PORT=3000
