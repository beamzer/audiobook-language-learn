# Kopieer dit bestand naar .env en vul je sleutels in.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Wachtwoord voor de beheerpagina (/admin), waar je boeken toevoegt en verwerkt.
# Zonder wachtwoord staat het beheer uit. Kies een lang wachtwoord; de gebruikersnaam maakt niet uit.
ADMIN_PASSWORD=

# Optioneel: andere ElevenLabs-stem (voice id uit je ElevenLabs Voice Library).
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optioneel: andere poort (standaard 3000). De server luistert alleen op 127.0.0.1.
# PORT=3000
